# Copia a .env o genera ambos con ../../scripts/seed-testnet.sh
PORT=4000
DATABASE_URL=postgres://tilcago:tilcago@localhost:5433/tilcago
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_EXPLORER=https://stellar.expert/explorer/testnet
ESCROW_CONTRACT_ID=C...
USDC_SAC_ID=C...
USDC_ASSET_CODE=TUSDC
USDC_ASSET_ISSUER=G...
PLATFORM_FEE_ADDRESS=G...
ADMIN_ADDRESS=G...
GAS_SPONSOR_SECRET=S...
GAS_MAX_FEE_STROOPS=2000000

# Cotización (ejemplo de la v3): referencia de mercado, margen y comisiones
RATE_REF_BOB=10.00
MARGIN_BPS=50
FEE_BPS_TOTAL=150
# Debe coincidir con fee_bps del contrato
FEE_BPS_PLATFORM=50
QUOTE_TTL_MIN=10
ORDER_TTL_MIN=120

# Demo: el OTP se devuelve en la respuesta en vez de enviarse por correo
OTP_DEV=true
ADMIN_EMAILS=admin@tilcago.test
CODE_PEPPER=cambia-esto
CORS_ORIGIN=http://localhost:5173,https://localhost,capacitor://localhost

# Solo testnet: clave del emisor del activo de prueba para el faucet de la app (vacío = apagado)
FAUCET_ISSUER_SECRET=
FAUCET_AMOUNT=100
