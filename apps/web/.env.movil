# Build para la app móvil (npm run build:movil). URL del API vista desde el celular:
#   Emulador de Android → http://10.0.2.2:4000 (así ve el emulador a tu computadora)
#   Simulador de iOS    → http://localhost:4000
#   Celular real        → la URL pública con HTTPS del API (o la IP de tu compu en el Wi-Fi, solo Android)
VITE_API_URL=http://10.0.2.2:4000
